# Cecelia Node Brain 配置
# 更新于 2026-02-05

# PostgreSQL (本地 US 数据库)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cecelia
DB_USER=cecelia
DB_PASSWORD=YOUR_PASSWORD_HERE

# === Cecelia Brain Config ===
CECELIA_TICK_ENABLED=true
CECELIA_TICK_INTERVAL_MS=5000
# CECELIA_MAX_CONCURRENT is deprecated since v1.35.0 - auto-calculated via slot-allocator.js
# 动态节流根据实时压力自动减少有效席位，无需手动限制
DISPATCH_TIMEOUT_MINUTES=60

# === Unified Fleet Worker transport (Phase 4B) ===
# Must match the protected worker-auth file installed on all canonical nodes.
KERNEL_FLEET_REMOTE_ENABLED=true
KERNEL_FLEET_BRIDGE_TOKEN=replace-with-worker-bearer-token
KERNEL_FLEET_REMOTE_CALLBACK_BASE_URL=http://100.71.151.105:5221

# === Region Identity ===
ENV_REGION=us

# === Cecelia Run ===
CLAUDE_HOME=/home/xx/.claude
SKILLS_PATH=/home/xx/.claude/skills
CLAUDE_MODEL=claude-sonnet-4-5

# === Feishu ===
# FEISHU_OWNER_OPEN_IDS: owner 的 open_id（逗号分隔），用于绕过 API 权限不足问题
# 注意：open_id 与 App 绑定，换 App 后必须更新（从 feishu_users 表或 webhook 事件获取）
FEISHU_OWNER_OPEN_IDS=ou_YOUR_OWNER_OPEN_ID_HERE

# === Bark 告警推送 ===
# 源：1Password CS Vault "Bark" 条目 → ~/.credentials/bark.env
BARK_TOKEN=your-bark-device-token

# === 独立验收裁判（DeepSeek via ToAPIs，harness-judge.js）===
# evaluateContractNode 回调后由独立裁判据【证据 + 合同 + Golden Path】复核 evaluator verdict。
# 源：1Password CS Vault "ToAPIs" 条目 notesPlain（sync-credentials.sh sync_notes → ~/.credentials/toapis.env）。
# Brain 容器内 ~/.credentials 已 read-only mount，harness-judge.js 在 env 缺失时回退读该文件。
TOAPIS_API_KEY=sk-YOUR_TOAPIS_KEY_HERE
TOAPIS_BASE_URL=https://toapis.com/v1
# 裁判调用失败默认 fail-open（保留 agent verdict）；设 1 改 fail-closed（裁判失败即 FAIL）
JUDGE_STRICT=0
