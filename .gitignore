node_modules

# 轻量 staging 部署前自检的临时构建目录（promote 前自检用，promote 后即换入 dist/）
apps/dashboard/.dist-staging/
apps/dashboard/dist.old/
# 人工放行闸运行时文件：待放行标记 + 常驻 staging 服务 PID/日志
apps/dashboard/.staging-pending
apps/dashboard/.staging-slot.pid
apps/dashboard/.staging-slot.log
apps/dashboard/.staging-notify.log
# dev 即时预览（perfect21:5225 蓝 DEV 旗）运行时文件
apps/dashboard/.dist-dev/
apps/dashboard/.dist-pwa-e2e/
apps/screenshots/
apps/dashboard/.dev-preview.pid
apps/dashboard/.dev-preview.log

# harness judge 每次运行写入的状态快照（纯运行时输出，追踪它会导致部署根
