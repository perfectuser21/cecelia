#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  codex-slot start [--project <safe-segment>] [--name <safe-segment>]
  codex-slot stop <handle>

Identity, team, account, agent, host and auth selection are server-controlled.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --actor|--tenant|--team|--account|--account-ref|--accounts|--host|--agent|--agent-id|--auth|--token)
      echo "codex-slot: authority field is not accepted: $arg" >&2
      usage
      exit 64
      ;;
  esac
done

case "${1:-}" in
  start|stop)
    ;;
  *)
    usage
    exit 64
    ;;
esac

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec node "$SCRIPT_DIR/codex-slot-client.mjs" "$@"
