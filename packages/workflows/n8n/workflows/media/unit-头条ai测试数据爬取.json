    {
      "id": "ssh",
      "name": "执行CDP爬虫",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        520,
        300
      ],
      "credentials": {
        "sshPrivateKey": {
          "id": "vvJsQOZ95sqzemla",
          "name": "VPS SSH Key"
        }
      },
      "parameters": {
        "authentication": "privateKey",
        "host": "134.199.234.147",
        "port": 22,
        "user": "xx",
        "command": "bash ~/platform_scrape.sh toutiao-2 2>/dev/null"
      },
      "continueOnFail": true
    },
    {
      "id": "code",
      "name": "解析结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "jsCode": "const ssh = $input.first().json;\nif (ssh.error || ssh.code !== 0) {\n  throw new Error('scraper SSH command failed');\n}\nlet data;\ntry {\n  data = JSON.parse((ssh.stdout || '').trim());\n} catch {\n  throw new Error('scraper output is not a single JSON result');\n}\nif (!data || data.success !== true) {\n  throw new Error('scraper did not report success');\n}\nif (Object.hasOwn(data, 'writeback') && data.writeback?.ok !== true) {\n  throw new Error('analytics writeback failed');\n}\nreturn [{ json: data }];"
      }
    }
  ],
  "connections": {
    "占位触发器": {
      "main": [
