{
  "name": "cecelia-brain",
  "type": "module",
  "description": "Cecelia Node.js Brain - decision engine, tick loop, and action system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "NODE_OPTIONS=\"--max-old-space-size=3072\" vitest run",
    "test:watch": "vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "backfill:l1": "node src/scripts/backfill-l1.js",
    "lint": "eslint src/",
    "audit:registry-vs-base": "node scripts/audit/registry-vs-base.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@dbos-inc/dbos-sdk": "^4.20.0",
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "acorn": "8.16.0",
    "ajv": "^8.20.0",
    "bullmq": "^5.28.2",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.1",
    "multer": "^2.2.0",
    "natural": "^7.0.7",
    "openai": "^6.49.0",
    "pg": "^8.12.0",
    "unzipper": "^0.12.5",
    "uuid": "^9.0.0",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.2",
    "globals": "^15.15.0",
    "supertest": "^7.2.2",
    "vitest": "^1.6.1",
    "zod-v3-compat": "npm:zod@3.25.76"
  },
  "version": "1.445.101",
  "overrides": {
    "fast-uri": "^3.1.6"
  }
}
