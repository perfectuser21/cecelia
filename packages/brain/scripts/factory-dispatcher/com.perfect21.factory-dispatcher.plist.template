<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 技能工厂派发器 LaunchAgent 模板（MMV 本机用户级常驻）。安装见同目录 README.md。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perfect21.factory-dispatcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@NODE@@</string>
    <string>@@SCRIPT@@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
    <key>BRAIN_URL</key>
    <string>http://localhost:5221</string>
    <key>FACTORY_DISPATCHER_STATE_DIR</key>
    <string>@@HOME@@/.factory-dispatcher</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@@HOME@@/Library/Logs/factory-dispatcher.log</string>
  <key>StandardErrorPath</key>
  <string>@@HOME@@/Library/Logs/factory-dispatcher.log</string>
</dict>
</plist>
