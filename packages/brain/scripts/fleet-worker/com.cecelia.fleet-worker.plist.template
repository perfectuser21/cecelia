<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perfect21.fleet-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@NODE_EXECUTABLE@@</string>
    <string>@@WORKER_SCRIPT@@</string>
  </array>
  <key>UserName</key>
  <string>_cecelia</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CECELIA_ORBSTACK_HOME</key>
    <string>@@ORBSTACK_HOME@@</string>
    <key>PATH</key>
    <string>/usr/local/libexec/cecelia/toolchain/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DOCKER_HOST</key>
    <string>unix:///var/run/docker.sock</string>
    <!-- 探测/attempt 临时目录必须落在 OrbStack 文件共享可读路径：_cecelia 私有
         /var/folders、/tmp 下 0700 目录 docker bind mount 一律 permission denied。 -->
    <key>TMPDIR</key>
    <string>/Users/Shared/cecelia-fleet-tmp</string>
    <key>CECELIA_MACHINE_ID</key>
    <string>@@MACHINE_ID@@</string>
    <key>CECELIA_RUNNER_DIGEST</key>
    <string>@@RUNNER_DIGEST@@</string>
    <key>CECELIA_CALLBACK_URL</key>
    <string>@@BRAIN_HEALTH_URL@@</string>
    <key>CECELIA_FLEET_WORKER_HOST</key>
    <string>@@WORKER_BIND_HOST@@</string>
    <key>CECELIA_FLEET_WORKER_PORT</key>
    <string>5231</string>
    <key>CECELIA_DRAIN_MARKER</key>
    <string>@@DRAIN_MARKER@@</string>
    <key>CECELIA_REPO_ROOT</key>
    <string>@@REPO_ROOT@@</string>
    <key>CECELIA_FLEET_WORKER_TOKEN_FILE</key>
    <string>@@WORKER_TOKEN_FILE@@</string>
    <key>CECELIA_FLEET_DATA_ROOT</key>
    <string>@@FLEET_DATA_ROOT@@</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@@STDOUT_LOG@@</string>
  <key>StandardErrorPath</key>
  <string>@@STDERR_LOG@@</string>
</dict>
</plist>
