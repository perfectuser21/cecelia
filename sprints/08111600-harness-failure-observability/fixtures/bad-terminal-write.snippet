// bad-terminal-write fixture — 供 lint-terminal-failure-class 机械闸自测。
// 这是一处「把 harness 任务打成 terminal 失败态但漏写 failure_class」的裸写入，
// 追加进被扫描源码后，机械闸必须命中并 exit 1（B-06 / E2E step6）。
async function __lintBadTerminalWriteFixture(pool, id) {
  await pool.query(
    `UPDATE tasks SET status = 'failed', completed_at = NOW()
       WHERE id = $1 AND task_type = 'harness_initiative'`,
    [id],
  );
}
